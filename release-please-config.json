{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ec023b4548eb3aee58ff53caa90398a23afe3718",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "candeo",
      "component": "candeo",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "pull-request-title-pattern": "Go release v${version} 🚀",
      "extra-files": [
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/effects-api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='candeo-desktop' || @.name.value=='candeo-device' || @.name.value=='candeo-protocol')].version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "ci", "section": "CI/CD" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ]
}
