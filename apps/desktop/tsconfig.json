{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* The shipped effects import the API by its package name, as every effect
       does; `packages/effects` has no dependencies of its own to resolve it. */
    "paths": {
      "@candeo/effects-api": ["../../packages/effects-api/src/index.ts"]
    }
  },
  /* `example.ts` de `@candeo/effects-api` est désigné comme l'effet de
     référence — le premier fichier qu'on montre à qui veut en écrire un — et
     rien ne le compilait : le paquet n'a ni `tsconfig.json` ni script, et
     l'application n'importe que `index.ts`, donc lui seul entrait dans le
     programme.

     Il est rattaché ici plutôt que dans un projet à part, et c'est le but :
     `vue-tsc --noEmit` tourne déjà sur cette configuration, en local comme dans
     le job `web`. Élargir ce qu'il lit ne coûte pas une étape d'intégration
     continue de plus — les minutes sont comptées — et vérifie l'exemple contre
     la version de l'API qui est dans l'arbre, pas contre une copie. */
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/effects-api/src/**/*.ts",
    "../../packages/effects/*.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
