# Rust
/target
**/target

# Node
node_modules
dist
.pnpm-store

# Tauri
apps/desktop/src-tauri/gen

# The page, built by site/build.mjs and uploaded by the Pages workflow
site/_site

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea
# The recommended extensions list is tracked, the rest of the folder is local.
# The only rule apps/desktop/.gitignore carried that the root did not: the rest
# of that file only repeated this one, or targeted yarn and lerna in a pnpm
# repository.
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Large captures: kept outside the repository
docs/captures/*.pcap

# Worktrees created by coding agents
.claude/worktrees/
